# Server
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (required)
MONGO_URI=mongodb://127.0.0.1:27017/smartbuy

# Auth (required — any long random strings)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Everything below is OPTIONAL. The app runs a full working demo with ---
# --- none of it set: deterministic requirement parsing, the seeded mock  ---
# --- catalog, and a "search on YouTube" fallback link.                  ---

# AI provider (Groq — OpenAI-compatible chat completions). Without this,
# natural-language requirement parsing falls back to a deterministic
# regex/keyword parser, and the product-detail follow-up chat is disabled.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
# Research current Indian product models before shopping. Uses Groq browser
# search and may add Groq usage charges. Set false for offline model selection.
GROQ_LIVE_SEARCH=true

# Primary Google Shopping discovery through SerpApi.
SERPAPI_KEY=

# Used for Real-Time Product Search and its price history, plus the
# Google Search Master subscriptions (MEGA and standard) for fallbacks.
# YouTube138 can use the same key if subscribed.
RAPIDAPI_KEY=your_rapidapi_key

# Set to "false" to enable recommendations from live shopping providers.
USE_MOCK_DATA=true

# Only needed if you want to use an official Google YouTube Data API v3 key
# instead of RapidAPI's YouTube138 for review search.
YOUTUBE_API_KEY=
